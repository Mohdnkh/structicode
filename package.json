{
  "name": "civil-engineering-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm run dev --workspace=frontend",
    "backend": "python -m uvicorn backend.api.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "npm run build --workspace=frontend",
    "verify:backend": "python -c \"import backend.api.main\"",
    "db:migrate": "python -m alembic upgrade head"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
